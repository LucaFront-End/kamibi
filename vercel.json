{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/((?!assets/).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/merchant-feed.tsv", "destination": "/api/merchant-feed" },
    { "source": "/merchant-feed", "destination": "/api/merchant-feed" },
    { "source": "/google-merchant.tsv", "destination": "/api/merchant-feed" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap?type=index" },
    { "source": "/sitemap-pages.xml", "destination": "/api/sitemap?type=pages" },
    { "source": "/sitemap-productos.xml", "destination": "/api/sitemap?type=productos" },
    { "source": "/sitemap-landings.xml", "destination": "/api/sitemap?type=landings" },
    { "source": "/sitemap-tiendas.xml", "destination": "/api/sitemap?type=tiendas" },
    { "source": "/sitemap-blog.xml", "destination": "/api/sitemap?type=blog" },
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/merchant-feed",
      "schedule": "0 */6 * * *"
    }
  ]
}
